# ── Site ──────────────────────────────────────────────────────────
# 정식 프로덕션 도메인은 www. 색인 허용은 이 값과 일치할 때만 동작한다(app/robots.ts).
NEXT_PUBLIC_SITE_URL=https://www.kkosunbox.com

# ── API ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── OAuth Client IDs ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# ── Dev 임시 로그인 자격증명 ──────────────────────────────────────
# 실제 인증 구현 전 개발용 마스터 계정
DEV_LOGIN_ID=
DEV_LOGIN_PASSWORD=
# 쿠키에 저장될 토큰 값 (충분히 유추하기 어려운 값으로 설정)
DEV_AUTH_TOKEN=

NEXT_PUBLIC_SITE_URL=

# ── Toss Payments (자동결제/빌링) ─────────────────────────────────
# requestBillingAuth 호출용 클라이언트 키.
# 자동결제는 리스크 검토·계약 후 사용 가능 — 미계약 키는 NOT_SUPPORTED_METHOD 에러.
# 테스트: 개발자센터 테스트 클라이언트 키 / 운영: 라이브 클라이언트 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# ── Toss Payments (결제위젯 SDK v1 — 단건 결제) ─────────────────────
# /shop/order, /purchase/order 단건 결제 주문 페이지 전용 클라이언트 키.
# 위 자동결제 키와는 별도 Toss 상품 — 공유하면 위젯 렌더링이 404로 실패한다
# (GET /v1/payment-widget/widget-groups/keys, "결제위젯" 상품 미활성화 계정).
# 백엔드 시크릿키와 짝(테스트/라이브)이 맞아야 결제 승인도 정상 동작한다.
NEXT_PUBLIC_TOSS_PURCHASE_CLIENT_KEY=

# 위 클라이언트 키와 짝이 되는 시크릿 키 — /shop/order/success가 Toss 결제 승인(confirm) 호출에 쓴다.
# 서버 전용(NEXT_PUBLIC_ 접두사 없음, 클라이언트 번들에 절대 포함되지 않음). Toss 개발자센터에서 발급.
# 값을 비워두면 /shop 결제 승인은 실패하지만(테스트 환경), 위젯 자체는 정상 로드된다.
TOSS_PURCHASE_SECRET_KEY=

# ── Analytics ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
# 🧪 Toss 빌링 디버그 로그 (임시) ─────────────────────────────
# 1로 두면 카드 등록/변경 요청·응답이 서버 로그에만 출력된다(브라우저에는 노출되지 않음).
# authKey·customerKey 원문이 남으므로 운영(live) 환경에서는 켜지 않는다. dev 검증 후 제거 예정.
BILLING_DEBUG_LOG=
